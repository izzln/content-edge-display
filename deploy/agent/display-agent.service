# 设备端播放代理 systemd 单元（Orange Pi One / Armbian）
# 由包内 update.sh 安装（首次安装与每次 OTA）；OTA 布局见 internal/agent/update.go
[Unit]
Description=Content Edge Display Agent
# 刻意不依赖 network-online.target：网线没插、DHCP 拿不到地址时，那个目标要等到超时
# （systemd-networkd-wait-online 默认 2 分钟）才放行，这期间屏幕是黑的。代理自己能处理没网的情况：
# 先播本地缓存，网络就绪后再注册、拉清单。
After=network.target

[Service]
Type=notify
# 更新回滚检查：新版本连续 3 次启动未确认则把 current 指回 previous
ExecStartPre=/usr/local/lib/display-agent/rollback-check.sh
ExecStart=/usr/local/lib/display-agent/current/display-agent -config /etc/display-agent/agent.json
# 软看门狗：代理主循环至少每 30 秒喂一次（下载、执行 update.sh 期间也喂），超过 90 秒没喂视为假死重启
WatchdogSec=90
Restart=always
RestartSec=5
# 更新时代理主动退出(码 0)，也要重启；连续崩溃不触发 start limit（由 rollback-check 兜底）
StartLimitIntervalSec=0
# /var/lib/display-agent：身份、缓存、播放状态。以 root 运行：播放进程要当 DRM master、访问视频解码器，
# 代理还要校准系统时钟、执行 update.sh、在救援时重启 tty1 的 getty。
StateDirectory=display-agent

[Install]
WantedBy=multi-user.target
