# 设备端播放代理 systemd 单元（Orange Pi One / Armbian）
# 由 install-agent.sh 安装；OTA 布局见 deploy/golden-image.md
[Unit]
Description=Content Edge Display Agent
# 刻意不依赖 network-online.target：网线没插、DHCP 拿不到地址时，那个目标要等到超时
# （systemd-networkd-wait-online 默认 2 分钟）才放行，这期间屏幕是黑的。代理自己能处理没网的情况：
# 先播本地缓存，网络就绪后再注册、拉清单。
After=network.target

[Service]
Type=notify
# 更新回滚检查：新版本连续 3 次启动未确认则把 current 指回 previous
ExecStartPre=/usr/local/lib/display-agent/rollback-check.sh /usr/local/lib/display-agent
ExecStart=/usr/local/lib/display-agent/current -config /etc/display-agent/agent.json
# 软看门狗: 代理主循环每 10~60s 发 WATCHDOG=1, 超过 90s 未喂狗则视为假死重启
WatchdogSec=90
Restart=always
RestartSec=5
# 更新时代理主动退出(码 0)，也要重启；连续崩溃不触发 start limit（由 rollback-check 兜底）
StartLimitIntervalSec=0
RuntimeDirectory=display-agent
RuntimeDirectoryMode=0700
StateDirectory=display-agent
# mpv 需要访问 DRM/GPU 设备; root 运行最简单(M1), M4 阶段再收紧为专用用户
User=root
Environment=HOME=/root
# mpv（经 libwayland/EGL 探测）要求 XDG_RUNTIME_DIR 指向一个存在的目录，否则每次启动都报
# "XDG_RUNTIME_DIR is invalid or not set"。系统服务没有登录会话，所以指向本服务自己的运行目录。
Environment=XDG_RUNTIME_DIR=/run/display-agent

[Install]
WantedBy=multi-user.target
