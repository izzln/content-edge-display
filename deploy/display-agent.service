# 设备端播放代理 systemd 单元（Orange Pi One / Armbian）
# 安装: cp display-agent.service /etc/systemd/system/ && systemctl enable --now display-agent
[Unit]
Description=Content Edge Display Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/display-agent -config /etc/display-agent/agent.json
# 软看门狗: 代理主循环每 30~60s 发 WATCHDOG=1, 超过 90s 未喂狗则视为假死重启
WatchdogSec=90
Restart=always
RestartSec=5
RuntimeDirectory=display-agent
StateDirectory=display-agent
# mpv 需要访问 DRM/GPU 设备; root 运行最简单(M1), M4 阶段再收紧为专用用户
User=root
Environment=HOME=/root

[Install]
WantedBy=multi-user.target
